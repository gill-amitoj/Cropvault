# Copy to .env and change the passwords: cp .env.example .env
# Never commit .env.

# PostgreSQL
POSTGRES_DB=cropvault
POSTGRES_USER=cropvault
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=cropvault
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=cropvault-images
MINIO_SECURE=false

# First admin account (used from Stage 1)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
